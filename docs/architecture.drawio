        <mxCell id="r_sos" value="&lt;b&gt;Lock for 24 h (Redis TTL)&lt;/b&gt;&lt;br&gt;send crisis response" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="503" width="260" height="54" as="geometry"/></mxCell>
        <mxCell id="d_probe" value="&lt;b&gt;Asking for a task or&lt;/b&gt;&lt;br&gt;probing the model?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="608" width="220" height="84" as="geometry"/></mxCell>
        <mxCell id="r_probe" value="&lt;b&gt;Deflect playfully, in character&lt;/b&gt;&lt;br&gt;maths, code, trivia, homework, jailbreak" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="623" width="260" height="54" as="geometry"/></mxCell>
        <mxCell id="prompt" value="&lt;b&gt;Choose the conversation mode&lt;/b&gt;&lt;br&gt;intro · name · onboarding · welcome · regular" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="728" width="300" height="56" as="geometry"/></mxCell>
