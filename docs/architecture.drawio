        <mxCell id="state" value="&lt;b&gt;Use the state from that read&lt;/b&gt;&lt;br&gt;heuristic + LLM, smoothed over turns" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="940" width="250" height="64" as="geometry"/></mxCell>
