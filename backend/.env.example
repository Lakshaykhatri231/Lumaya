PORT=3000
NODE_ENV=development

# Supabase (Auth + Postgres)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis: sessions, live chat context, user profiles, crisis locks
REDIS_URL=redis://localhost:6379
SESSION_SECRET=

# Google Gemini: replies, analysis, embeddings
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-exp-03-07
# Set to "off" to skip the per-message LLM read of the user's state (the offline heuristic still runs)
# PERSONA_STATE_DETECTION=off

# Pinecone: per-user long-term memory (index dimension must be 1024)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX2=

# Hugging Face: mood and topic labels for memory summaries
HUGGINGFACE_API_KEY=
HUGGINGFACE_API_KEY1=

# Paddle: payments webhook (PADDLE_ENV=sandbox when testing)
PADDLE_API_KEY=
WEBHOOK_SECRET_KEY=
# PADDLE_ENV=sandbox

# Resend: verification and welcome emails
RESEND_API_KEY=

# CORS: the frontend's URL, plus any extra origins (comma separated)
FRONTEND_URL=http://localhost:5173
# FRONTEND_ORIGINS=

# Comma-separated Supabase user ids allowed to use /api/admin/*
ADMIN_USER_IDS=
